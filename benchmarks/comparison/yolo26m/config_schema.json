  "native_fixed_optimizer_semantics": {
    "MuSGD": {
      "muon": 0.5,
      "sgd": 0.5,
      "grouping": "pinned build_optimizer; ndim>=2 mixed group; native regex 3x LR",
      "warmup": "real bias roles; preserve per-group initial_lr"
    },
    "Adam_AdamW": {
      "beta2": 0.999,
      "eps": 1e-08,
      "momentum": "beta1"
    }
  },
  "fixed": {
    "task": "detect",
    "initialization_type": "coco_detection_pretrained",
