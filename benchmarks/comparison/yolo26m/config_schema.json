    "pretrained": true,
    "single_cls": false,
    "classes": null,
    "conf": 0.001,
    "iou": 0.7,
    "max_det": 300,
    "agnostic_nms": false,
    "augment": false
  },
  "inactive_detection_fields": [
    "erasing",
    "auto_augment"
